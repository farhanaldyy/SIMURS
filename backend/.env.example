DATABASE_URL=mysql://simurs:simurs_pass@localhost:3306/simurs
JWT_SECRET=your-jwt-secret-key
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key
PORT=3000
NODE_ENV=development

# Optional: Path ke binary client MariaDB/MySQL jika tidak ada di system PATH (terutama di Windows)
# Contoh untuk Laragon di Windows (cukup arahkan ke folder versi):
# MYSQL_PATH="C:\laragon\bin\mysql\mysql-5.7.33-winx64"
# atau spesifik file:
# MYSQL_DUMP_PATH="C:\laragon\bin\mysql\mysql-5.7.33-winx64\bin\mysqldump.exe"
# MYSQL_BIN_PATH="C:\laragon\bin\mysql\mysql-5.7.33-winx64\bin\mysql.exe"
# BACKUP_DIR=
